<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="Cuenta de stripe" order="100" display="left">
            <widget type="text" fieldname="stripe_account" />
        </column>

        <column name="Tipo de evento" order="105" display="left">
            <widget type="text" fieldname="event" />
        </column>

        <column name="Evento" order="110" display="left">
            <widget type="text" fieldname="object_id" />
        </column>

        <column name="Fecha del pago" order="115" display="left">
            <widget type="text" fieldname="object_date" />
        </column>

<!--        <column name="Tipo de transacción" order="120" display="left">-->
<!--            <widget type="text" fieldname="transaction_type" />-->
<!--        </column>-->

        <column name="Transacción" order="125" display="left">
            <widget type="text" fieldname="transaction_id" />
        </column>

        <column name="Tipo de destino" order="130" display="center">
            <widget type="text" fieldname="destination" />
        </column>

        <column name="Destino" order="135" display="center">
            <widget type="text" fieldname="destination_id" />
        </column>

        <column name="Estado" order="140" display="center">
            <widget type="text" fieldname="status" />
        </column>

        <column name="Tipo de error" order="145" display="center">
            <widget type="text" fieldname="error_type" />
        </column>

        <column name="Fecha" order="150" display="center">
            <widget type="datetime" fieldname="created_at" />
        </column>
    </columns>

    <modals>
        <group name="stripe-link" title="Vincular factura" icon="fa-brands fa-stripe">
            <column name="Factura de FacturaScripts" numcolumns="12" order="100">
                <widget type="autocomplete" fieldname="fs_invoice_id" required="true">
                    <values source="FacturaCliente" fieldcode="idfactura" fieldtitle="codigo" />
                </widget>
            </column>
        </group>
    </modals>
</view>
