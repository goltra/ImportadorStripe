{% extends 'Master/MenuTemplate.html.twig' %}

{% block body %}

    <div class="container-fluid mt-3">
        <div class="row">
            <div class="col">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h1 class="h4 mb-0">
                            <i class="fa-solid fa-file-invoice-dollar me-2" aria-hidden="true"></i>
                            Facturas de Stripe
                        </h1>
                    </div>
                    <div class="card-body">
                        <form action="{{ asset('ListInvoiceStripe') }}?action=load" method="post">
                            <div class="row g-3 align-items-end">
                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label" for="f-ini-date">Fecha inicial</label>
                                    <input type="date" class="form-control" name="f-ini-date" id="f-ini-date" autocomplete="off"
                                           value="{{ fsc.f_ini }}"/>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label" for="f-fin-date">Fecha final</label>
                                    <input type="date" class="form-control" name="f-fin-date" id="f-fin-date" autocomplete="off"
                                           value="{{ fsc.f_fin }}"/>
                                </div>
                                <div class="col-sm-12 col-md-4">
                                    <label class="form-label" for="sk_stripe_index">Cuenta de Stripe</label>
                                    <select id="sk_stripe_index" name="sk_stripe_index" class="form-select">
                                        {% for key,value in fsc.sks_stripe %}
                                            <option {% if(key == fsc.sk_stripe_index) %} selected {% endif %}
                                                    value="{{ key }}">{{ value.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-sm-12 col-md-2">
                                    <button onclick="muestraSpinner(true)" class="btn btn-info w-100" type="submit">
                                        <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i> Consultar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                {% if(fsc.action=='load') %}
                    {% set res = fsc.invoices %}
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">
                                <i class="fa-solid fa-list me-2" aria-hidden="true"></i>
                                Facturas pendientes de procesar
                            </h2>
                            <span class="badge bg-primary rounded-pill">{{ res.data|length }}</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">{{ fsc.textFilter }}</p>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Email</th>
                                        <th>Cliente FS</th>
                                        <th class="text-end">Importe</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for f in res.data %}
                                        <tr>
                                            <td>{{ f.date }}</td>
                                            <td>{{ f.customer_email }}</td>
                                            <td>
                                                {% if f.fs_idFsCustomer %}
                                                    <a href="{{ asset('EditCliente') }}?code={{ f.fs_idFsCustomer }}"
                                                       target="_blank">{{ f.fs_customerName }}</a>
                                                    <a href="{{ asset('SelectClient') }}?stripe_customer_id={{ f.customer_id }}&source=ListInvoiceStripe&action=changing"
                                                       class="ms-1" title="Cambiar cliente">
                                                        <i class="fas fa-pencil-alt" aria-hidden="true"></i>
                                                    </a>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end">{{ f.amount }}</td>
                                            <td><span class="badge bg-secondary">{{ f.status }}</span></td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="{{ asset('CreateInvoiceStripe') }}?action=check&id={{ f.id }}&sk_stripe_index={{ fsc.sk_stripe_index }}"
                                                   title="Crear factura">
                                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">No hay facturas pendientes.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {{ include('_spinner.html.twig') }}

{% endblock %}
